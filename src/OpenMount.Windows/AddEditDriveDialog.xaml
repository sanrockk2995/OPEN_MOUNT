<Window x:Class="OpenMount.Windows.AddEditDriveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Drive - OpenMount" Height="760" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtHeader" Text="Add New Drive" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,16"/>

        <!-- Common Settings -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Drive Letter:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbDriveLetter" Grid.Column="1" Height="28" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Drive Label:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLabel" Grid.Row="1" Grid.Column="1" Height="28" VerticalAlignment="Center" Text="My Cloud Drive"/>

            <CheckBox x:Name="ChkAutoMount" Grid.Row="2" Grid.Column="1" Content="Mount automatically on startup" VerticalAlignment="Center"/>
        </Grid>

        <!-- Provider Tabs -->
        <TabControl x:Name="TabProviders" Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}">
            <!-- Local Tab -->
            <TabItem Header="Local Folder" x:Name="TabLocal">
                <StackPanel Margin="16">
                    <TextBlock Text="Local Directory Path:" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLocalPath" Height="28" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BtnBrowseLocal_Click" Width="80"/>
                    </Grid>
                    <TextBlock Text="Mounts any existing local or network folder as a standalone virtual drive letter." 
                               TextWrapping="Wrap" Foreground="#666666" Margin="0,12,0,0" FontSize="11"/>
                </StackPanel>
            </TabItem>

            <!-- Google Drive Tab -->
            <TabItem Header="Google Drive" x:Name="TabGDrive">
                <StackPanel Margin="16">
                    <TextBlock Text="OAuth Client ID:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtGDriveClientId" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="OAuth Client Secret:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="TxtGDriveClientSecret" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Account Identifier:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtGDriveUser" Height="26" Text="default" Margin="0,0,0,12"/>

                    <Button x:Name="BtnAuthorizeGDrive" Content="Authorize with Google..." Click="BtnAuthorizeGDrive_Click" Background="#34A853"/>
                    <TextBlock x:Name="TxtGDriveAuthStatus" Text="Not authorized" Foreground="#666666" Margin="0,6,0,0" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem>

            <!-- S3 / MinIO Tab -->
            <TabItem Header="S3 / MinIO" x:Name="TabS3">
                <StackPanel Margin="16">
                    <TextBlock Text="Endpoint URL (default: AWS S3):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtS3Endpoint" Height="26" Text="https://s3.amazonaws.com" Margin="0,0,0,8"/>

                    <TextBlock Text="Bucket Name:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtS3Bucket" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Access Key:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtS3AccessKey" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Secret Key:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="TxtS3SecretKey" Height="26" Margin="0,0,0,8"/>
                </StackPanel>
            </TabItem>

            <!-- WebDAV Tab -->
            <TabItem Header="WebDAV" x:Name="TabWebDav">
                <StackPanel Margin="16">
                    <TextBlock Text="Server URL (e.g. https://nextcloud.local/remote.php/webdav):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtWebDavUrl" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Remote Path (default: /):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtWebDavPath" Height="26" Text="/" Margin="0,0,0,8"/>

                    <TextBlock Text="Username:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtWebDavUser" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Password:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="TxtWebDavPassword" Height="26" Margin="0,0,0,8"/>
                </StackPanel>
            </TabItem>

            <!-- SFTP Tab -->
            <TabItem Header="SFTP" x:Name="TabSftp">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Host / Server IP:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtSftpHost" Height="26"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Port:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtSftpPort" Height="26" Text="22"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Remote Root Path (default: /):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtSftpPath" Height="26" Text="/" Margin="0,0,0,8"/>

                        <TextBlock Text="Username:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtSftpUser" Height="26" Margin="0,0,0,8"/>

                        <TextBlock Text="Password:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="TxtSftpPassword" Height="26" Margin="0,0,0,8"/>

                        <TextBlock Text="Private Key File (optional):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSftpKeyPath" Height="26"/>
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BtnBrowseSftpKey_Click" Width="70"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- FTP / FTPS Tab -->
            <TabItem Header="FTP / FTPS" x:Name="TabFtp">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="FTP Host:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtFtpHost" Height="26"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Port:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtFtpPort" Height="26" Text="21"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Encryption:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbFtpEncryption" Height="26" Margin="0,0,0,8">
                        <ComboBoxItem Content="Plain FTP (Insecure)" IsSelected="True"/>
                        <ComboBoxItem Content="Explicit FTPS (FTPES / TLS)"/>
                        <ComboBoxItem Content="Implicit FTPS (Port 990)"/>
                    </ComboBox>

                    <TextBlock Text="Remote Path (default: /):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtFtpPath" Height="26" Text="/" Margin="0,0,0,8"/>

                    <TextBlock Text="Username:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtFtpUser" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Password:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="TxtFtpPassword" Height="26" Margin="0,0,0,8"/>
                </StackPanel>
            </TabItem>

            <!-- pCloud Tab -->
            <TabItem Header="pCloud" x:Name="TabPCloud">
                <StackPanel Margin="16">
                    <TextBlock Text="Data Center Location:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbPCloudLocation" Height="26" Margin="0,0,0,8">
                        <ComboBoxItem Content="United States (api.pcloud.com)" IsSelected="True"/>
                        <ComboBoxItem Content="European Union (eapi.pcloud.com)"/>
                    </ComboBox>

                    <TextBlock Text="pCloud Email / Account:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtPCloudUser" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Password:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="TxtPCloudPassword" Height="26" Margin="0,0,0,8"/>

                    <TextBlock Text="Remote Folder Path (default: /):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtPCloudPath" Height="26" Text="/" Margin="0,0,0,8"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Advanced RaiDrive-style Options -->
        <Border Grid.Row="3" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Advanced Options (Performance &amp; Sync)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="ChkFilePreview" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="File preview" VerticalAlignment="Center"/>
                                <Border Background="#444444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock Text="SLOW" FontSize="9" Foreground="#CCCCCC" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkInstantProperties" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Get file properties instantly" VerticalAlignment="Center"/>
                                <Border Background="#444444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock Text="SLOW" FontSize="9" Foreground="#CCCCCC" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkAsyncUpload" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Update storage changes asynchronously" VerticalAlignment="Center"/>
                                <Border Background="#444444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock Text="SLOW" FontSize="9" Foreground="#CCCCCC" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkMaintainDateModified" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Maintain Date modified" VerticalAlignment="Center"/>
                                <Border Background="#444444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock Text="SLOW" FontSize="9" Foreground="#CCCCCC" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkMonitorProcessAccess" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Monitor process access to files" VerticalAlignment="Center"/>
                                <Border Background="#444444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                    <TextBlock Text="SLOW" FontSize="9" Foreground="#CCCCCC" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkQuickRemoteOperations" Margin="0,0,0,4">
                            <TextBlock Text="Quick Copy/Move/Delete (Server-side)" VerticalAlignment="Center"/>
                        </CheckBox>
                        
                        <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                            <RadioButton x:Name="RbOverwrite" Content="Overwrite target" GroupName="ConflictGroup" Margin="0,0,8,0" IsChecked="True" FontSize="11"/>
                            <RadioButton x:Name="RbRenameSource" Content="Rename source" GroupName="ConflictGroup" Margin="0,0,8,0" FontSize="11"/>
                            <RadioButton x:Name="RbSkip" Content="Skip" GroupName="ConflictGroup" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" MinWidth="95" Padding="12,6" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button Content="Cancel" MinWidth="95" Padding="12,6" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
